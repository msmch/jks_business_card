---
/**
 * Footer.astro
 * Minimalna, biała stopka z CTA do Messengera/Facebooka/Telefonu agenta.
 */

import {
  MESSENGER_URL,
  FACEBOOK_URL,
  PHONE_NUMBER,
  PHONE_CLEAN,
} from "../data/socials.ts";
---

<footer id="kontakt" class="footer-wrapper">
  <div class="footer-inner">
    <h2
      class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight mb-8"
    >
      Znajdziesz mnie tutaj
    </h2>

    <div class="footer-ctas">
      <!-- Phone CTA -->
      <a
        href={`tel:${PHONE_CLEAN}`}
        class="cta-link phone-link"
        aria-label="Zadzwoń do mnie"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 48 48"
          class="cta-icon"
          aria-hidden="true"
        >
          <circle cx="24" cy="24" r="24" fill="#10B981"></circle>
          <g transform="translate(12, 12)">
            <path
              fill="#fff"
              d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"
            ></path>
          </g>
        </svg>
        <div class="phone-label-wrapper">
          <span class="cta-label default-label">Zadzwoń</span>
          <span class="cta-label hover-label">{PHONE_NUMBER}</span>
        </div>
      </a>

      <!-- Messenger CTA -->
      <a
        href={MESSENGER_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-link"
        aria-label="Napisz do mnie na Messengerze"
      >
        <!-- Messenger SVG icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 48 48"
          class="cta-icon"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="msg-grad" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#0078FF"></stop>
              <stop offset="100%" stop-color="#A334FA"></stop>
            </linearGradient>
          </defs>
          <circle cx="24" cy="24" r="24" fill="url(#msg-grad)"></circle>
          <path
            fill="#fff"
            d="M24 6C14.06 6 6 13.6 6 23c0 5.34 2.66 10.1 6.82 13.23V42l5.9-3.24C20.47 39.54 22.2 39.8 24 39.8c9.94 0 18-7.6 18-16.8S33.94 6 24 6zm1.9 22.6-4.57-4.87-8.93 4.87 9.82-10.43 4.68 4.87 8.82-4.87-9.82 10.43z"
          ></path>
        </svg>
        <span class="cta-label">Messenger</span>
      </a>

      <!-- Facebook CTA -->
      <a
        href={FACEBOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-link"
        aria-label="Odwiedź mój profil na Facebooku"
      >
        <!-- Facebook SVG icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 48 48"
          class="cta-icon"
          aria-hidden="true"
        >
          <circle cx="24" cy="24" r="24" fill="#1877F2"></circle>
          <path
            fill="#fff"
            d="M31.5 16H28c-.83 0-1 .42-1 1v2.5h4.5l-.6 4.5H27V38h-5V24h-3v-4.5h3V17c0-3.87 2.37-6 5.79-6 1.65 0 3.71.3 3.71.3V16z"
          ></path>
        </svg>
        <span class="cta-label">Facebook</span>
      </a>
    </div>

    <p class="footer-copy">
      © {new Date().getFullYear()} Joanna Kardas-Śmiechowicz. Wszelkie prawa zastrzeżone.
    </p>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: #ffffff;
    border-top: 1px solid #e8eaed;
    padding: 2.5rem 1rem 2rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #1f2025;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .footer-ctas {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 2rem;
  }

  .cta-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }

  .cta-link:hover {
    transform: translateY(-3px);
    opacity: 0.85;
  }

  .cta-icon {
    width: 3.5rem; /* 56px — duża, wyraźna ikona */
    height: 3.5rem;
    display: block;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .cta-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #4b5563;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .phone-label-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 15px;
  }

  .hover-label {
    display: none;
    color: #10b981;
  }

  .phone-link:hover .default-label {
    display: none;
  }

  .phone-link:hover .hover-label {
    display: block;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: #9ca3af;
    padding-top: 4rem;
  }

  /* Responsywność — na bardzo małych ekranach ikony w pionie */
  @media (max-width: 360px) {
    .footer-ctas {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

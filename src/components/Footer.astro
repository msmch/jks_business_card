---
/**
 * Footer.astro
 * Minimalna, biała stopka z CTA do Messengera/Facebooka agenta.
 * Zmień MESSENGER_URL na właściwy link do profilu.
 */

const MESSENGER_URL = 'https://m.me/twoj.profil'; // ← zmień na swój link
const FACEBOOK_URL  = 'https://facebook.com/twoj.profil'; // ← zmień na swój link
---

<footer class="footer-wrapper">
  <div class="footer-inner">
    <p class="footer-label">Jesteśmy tu:</p>

    <div class="footer-ctas">
      <!-- Messenger CTA -->
      <a
        href={MESSENGER_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-link"
        aria-label="Napisz do nas na Messengerze"
      >
        <!-- Messenger SVG icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 48 48"
          class="cta-icon"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="msg-grad" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#0078FF"/>
              <stop offset="100%" stop-color="#A334FA"/>
            </linearGradient>
          </defs>
          <circle cx="24" cy="24" r="24" fill="url(#msg-grad)"/>
          <path
            fill="#fff"
            d="M24 6C14.06 6 6 13.6 6 23c0 5.34 2.66 10.1 6.82 13.23V42l5.9-3.24C20.47 39.54 22.2 39.8 24 39.8c9.94 0 18-7.6 18-16.8S33.94 6 24 6zm1.9 22.6-4.57-4.87-8.93 4.87 9.82-10.43 4.68 4.87 8.82-4.87-9.82 10.43z"
          />
        </svg>
        <span class="cta-label">Messenger</span>
      </a>

      <!-- Facebook CTA -->
      <a
        href={FACEBOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-link"
        aria-label="Odwiedź nasz profil na Facebooku"
      >
        <!-- Facebook SVG icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 48 48"
          class="cta-icon"
          aria-hidden="true"
        >
          <circle cx="24" cy="24" r="24" fill="#1877F2"/>
          <path
            fill="#fff"
            d="M31.5 16H28c-.83 0-1 .42-1 1v2.5h4.5l-.6 4.5H27V38h-5V24h-3v-4.5h3V17c0-3.87 2.37-6 5.79-6 1.65 0 3.71.3 3.71.3V16z"
          />
        </svg>
        <span class="cta-label">Facebook</span>
      </a>
    </div>

    <p class="footer-copy">
      © {new Date().getFullYear()} RealEstate. Wszelkie prawa zastrzeżone.
    </p>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: #ffffff;
    border-top: 1px solid #E8EAED;
    padding: 2.5rem 1rem 2rem;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #1F2025;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .footer-ctas {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .cta-link:hover {
    transform: translateY(-3px);
    opacity: 0.85;
  }

  .cta-icon {
    width: 3.5rem;   /* 56px — duża, wyraźna ikona */
    height: 3.5rem;
    display: block;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .cta-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #4B5563;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: #9CA3AF;
    margin: 0;
  }

  /* Responsywność — na bardzo małych ekranach ikony w pionie */
  @media (max-width: 360px) {
    .footer-ctas {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

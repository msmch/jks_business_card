---
import { FACEBOOK_URL } from "../data/socials.ts";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import defaultAgentImg from "../assets/images/agent_card_small.webp";

interface Props {
    name?: string;
    role?: string;
    image?: ImageMetadata;
    facebookUrl?: string;
}

const {
    name = "Joanna Kardas-Śmiechowicz",
    role = "Prawnik i Agent Nieruchomości",
    image = defaultAgentImg,
    facebookUrl = FACEBOOK_URL,
} = Astro.props;
---

<div
    class="not-prose flex flex-col sm:flex-row overflow-hidden border border-gray-200 rounded-[1.25rem] bg-white my-12 shadow-sm hover:shadow-lg transition-shadow duration-300"
>
    <div class="w-full sm:w-2/5 md:w-1/3 shrink-0">
        <Image
            src={image}
            alt={name}
            loading="lazy"
            class="w-full h-64 sm:h-full object-cover object-top m-0 block"
        />
    </div>

    <div
        class="flex-1 flex flex-col items-center justify-center text-center p-8 sm:p-10"
    >
        <h4 class="text-2xl font-bold text-gray-900 m-0">{name}</h4>
        <p class="text-gray-500 font-medium mt-2 mb-8">{role}</p>

        <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary-custom"
        >
            Odwiedź mój profil
        </a>
    </div>
</div>

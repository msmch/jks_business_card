---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Joanna Kardas-Śmiechowicz — Prawnik i Agent Nieruchomości"
  description="Pośrednictwo w obrocie nieruchomościami. Bezpieczne transakcje dzięki profesjonalnej obsłudze prawnej. Zaufaj doświadczeniu."
>
  <!-- ══════════════════════════════════════════════════════════
       HERO SECTION
       Desktop: 2 kolumny (zdjęcie | tekst), min-h-screen
       Mobile:  jedna kolumna — tekst najpierw, zdjęcie pod spodem
  ══════════════════════════════════════════════════════════ -->
  <section class="hero-section">
    <div class="hero-grid">
      <!-- ── LEWA KOLUMNA — placeholder na zdjęcie agenta ─────── -->
      <div class="photo-col bg-white">
        <img
          src="/images/agent_zdjecie.png"
          alt="Zdjęcie agenta"
          class="w-full h-full object-cover object-center aspect-[3/4] md:aspect-auto"
        />
      </div>

      <!-- ── PRAWA KOLUMNA — treść ──────────────────────────────── -->
      <div class="content-col px-6 md:pl-20 lg:pl-24">
        <!-- Kicker / tag marki -->
        <p class="kicker">PRAWO &amp; NIERUCHOMOŚCI</p>

        <!-- Główny nagłówek -->
        <h1 class="headline">
          Joanna Kardas-Śmiechowicz
          <span class="headline-sub">Agent nieruchomości</span>
        </h1>

        <!-- Krótki opis -->
        <p class="lead">
          Pośrednictwo w obrocie nieruchomościami.
          <br />
          Bezpieczeństwo umów, due diligence, negocjacje — wszystko w jednym miejscu.
        </p>

        <!-- CTA -->
        <div class="cta-row">
          <a href="#kontakt" class="btn-primary-custom">Umów konsultację</a>
          <a href="#oferta" class="btn-ghost-custom">Zobacz ofertę →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA OFERT ────────────────────────────────────────── -->
  <section id="oferta" class="py-28 md:py-40 bg-base-200">
    <div class="w-full px-6 lg:px-16 2xl:px-24">
      <div class="w-full flex flex-col items-center justify-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
          Aktualne Oferty
        </h2>
        <p class="text-center text-gray-500 mt-4 max-w-2xl mx-auto">
          Ekskluzywne nieruchomości starannie wyselekcjonowane dla najbardziej
          wymagających klientów.
        </p>
      </div>

      <div
        class="carousel carousel-center w-full max-w-full p-4 gap-6 lg:gap-10 rounded-box"
      >
        <!-- Karta 1 -->
        <div class="carousel-item">
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="card w-80 md:w-96 bg-base-100 shadow-sm hover:shadow-md transition-shadow duration-300 border border-base-300 rounded-xl overflow-hidden group"
          >
            <figure class="relative overflow-hidden">
              <img
                src="https://placehold.co/600x800/e2e8f0/64748b?text=Apartament"

<style>
  /* ── HERO WRAPPER ─────────────────────────────────────────────── */
  .hero-section {
    min-height: 100svh; /* pełna wysokość viewportu               */
    display: flex;
    align-items: stretch;
    background-color: #ffffff;
  }

  /* ── GRID ─────────────────────────────────────────────────────── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* desktop: 50/50                */
    width: 100%;
  }

  /* ── LEWA KOLUMNA — placeholder zdjęcia ──────────────────────── */
  .photo-col {
    display: flex;
    align-items: stretch;
  }

  .photo-icon {
    width: 5rem;
    height: 5rem;
    opacity: 0.45;
  }

  .photo-hint {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* ── PRAWA KOLUMNA — treść ────────────────────────────────────── */
  .content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    padding-right: 6rem;
    /* padding-left jest obsługiwany przez klasy Tailwind (md:pl-20) */
    gap: 1.75rem;
  }

  /* Kicker — etykieta marki w magenta */
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ef0081; /* brand magenta                         */
    margin: 0;
  }

  /* Główny nagłówek */
  .headline {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1f2025;
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .headline-sub {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 400;
    color: #4b5563;
    letter-spacing: 0em;
  }

  /* Lead — krótki opis */
  .lead {
    font-size: 1rem;
    line-height: 1.75;
    color: #6b7280;
    max-width: 38ch;
    margin: 0;
  }

  /* CTA row */
  .cta-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary-custom {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background-color: #ef0081;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 0.375rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      background-color 0.18s ease,
      transform 0.18s ease;
  }

  .btn-primary-custom:hover {
    background-color: #d40072;
    transform: translateY(-1px);
  }

  .btn-ghost-custom {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #4b5563;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.18s ease;
  }

  .btn-ghost-custom:hover {
    color: #ef0081;
  }

  /* ── RESPONSIVE — mobile ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero-section {
      min-height: 100svh;
      align-items: flex-start;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    /* Na mobile: tekst na górze, zdjęcie pod spodem */
    .content-col {
      order: 1;
      padding-top: 3rem;
      padding-bottom: 2rem;
      padding-right: 1.5rem;
      /* pl jest w Tailwind (px-6) */
      gap: 1.25rem;
    }

    .photo-col {
      order: 2;
      min-height: 55vw; /* zachowanie proporcji portretowych     */
    }

    .lead {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .content-col {
      padding-top: 2.5rem;
      padding-bottom: 1.5rem;
      padding-right: 1.25rem;
    }

    .cta-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .btn-primary-custom {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.querySelector(".carousel");
    if (!carousel) return;

    let scrollAmount = 0;
    const step = 300; // O ile pikseli ma się przesuwać

    setInterval(() => {
      if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth) {
        // Jeśli dojechał do końca, wraca na start
        carousel.scrollTo({ left: 0, behavior: "smooth" });
      } else {
        // Przewija w prawo
        carousel.scrollBy({ left: step, behavior: "smooth" });
      }
    }, 3000); // Zmiana co 3 sekundy (3000 ms)
  });
</script>

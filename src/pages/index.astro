---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { oferty } from "../data/oferty.ts";

// Pobieramy wszystkie wpisy z kolekcji 'blog' i sortujemy od najnowszego
const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Joanna Kardas-Śmiechowicz — Prawnik i Agent Nieruchomości"
  description="Pośrednictwo w obrocie nieruchomościami. Bezpieczne transakcje dzięki profesjonalnej obsłudze prawnej. Zaufaj doświadczeniu."
>
  <!-- ══════════════════════════════════════════════════════════
       HERO SECTION
       Desktop: 2 kolumny (zdjęcie | tekst), min-h-screen
       Mobile:  jedna kolumna — tekst najpierw, zdjęcie pod spodem
  ══════════════════════════════════════════════════════════ -->
  <section class="hero-section">
    <div class="hero-grid">
      <!-- ── LEWA KOLUMNA — placeholder na zdjęcie agenta ─────── -->
      <div class="photo-col bg-white">
        <img
          src="/images/agent_zdjecie.png"
          alt="Zdjęcie agenta"
          class="w-full h-full object-cover object-center aspect-[3/4] md:aspect-auto overflow-hidden"
        />
      </div>

      <!-- ── PRAWA KOLUMNA — treść ──────────────────────────────── -->
      <div class="content-col px-6 md:pl-20 lg:pl-24">
        <!-- Kicker / tag marki -->
        <p class="kicker">PRAWO &amp; NIERUCHOMOŚCI</p>

        <!-- Główny nagłówek -->
        <h1 class="headline">
          Joanna Kardas-Śmiechowicz
          <span class="headline-sub hidden md:inline-block"
            >Agent nieruchomości</span
          >
        </h1>

        <!-- Krótki opis -->
        <p class="lead lead-desktop">
          Pośrednictwo w obrocie nieruchomościami.
        </p>
        <p class="lead">
          Bezpieczeństwo umów, due diligence, negocjacje — wszystko w jednym
          miejscu.
        </p>

        <!-- CTA -->
        <div class="cta-row">
          <a href="#kontakt" class="btn-primary-custom">Umów konsultację</a>
          <a href="#oferta" class="btn-ghost-custom">Zobacz ofertę →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA OFERT ────────────────────────────────────────── -->
  <section id="oferta" class="offer-section py-32 md:py-48 bg-base-200">
    <div class="container-layout">
      <div
        class="w-full flex flex-col items-center justify-center mb-24 md:mb-32"
        style="margin-bottom: 3rem;"
      >
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
          Oferta
        </h2>
        <br />
        <p class="text-center text-gray-500 mt-4 max-w-2xl mx-auto">
          Zapraszam do zapoznania się z aktualnymi ofertami nieruchomości.
          Kliknij w ofertę aby dowiedzieć się więcej.
        </p>
      </div>

      <div class="relative w-full group/carousel">
        <button
          class="prev-btn absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full shadow-lg border border-gray-100 hidden md:flex items-center justify-center text-[#EF0081] hover:bg-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer opacity-0 group-hover/carousel:opacity-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5L8.25 12l7.5-7.5"></path>
          </svg>
        </button>

        <div
          class="carousel carousel-center w-full max-w-full p-4 gap-6 lg:gap-10 rounded-box relative"
        >
          {
            oferty.map((oferta) => (
              <div class="carousel-item">
                <a
                  href={oferta.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card w-[22rem] md:w-[28rem] lg:w-[32rem] bg-base-100 shadow-sm hover:shadow-lg transition-shadow duration-300 border border-base-200 rounded-2xl overflow-hidden group"
                >
                  <figure class="relative overflow-hidden">
                    <img
                      src={oferta.image}
                      alt={oferta.alt}
                      class="w-full h-72 md:h-80 object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                  </figure>
                  <div class="card-body !p-4 md:!p-6">
                    <h3 class="card-title text-2xl font-bold text-gray-900 mb-3 leading-tight">
                      {oferta.title}
                    </h3>
                    <div class="flex items-center text-gray-500 text-base mb-6">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 mr-2 text-gray-400 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                      <span class="truncate">{oferta.location}</span>
                    </div>
                    <div class="mt-auto flex justify-between items-end">
                      <div class="text-[#EF0081] font-bold text-2xl tracking-tight">
                        {oferta.price}
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            ))
          }
        </div>

        <button
          class="next-btn absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full shadow-lg border border-gray-100 hidden md:flex items-center justify-center text-[#EF0081] hover:bg-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer opacity-0 group-hover/carousel:opacity-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA O MNIE ────────────────────────────────────────── -->
  <section id="o-mnie" class="o-mnie-section py-32 md:py-48 bg-white">
    <div class="container-layout">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <!-- TEKST -->
        <div class="flex flex-col justify-center order-1">
          <p
            class="text-[#EF0081] font-bold tracking-[0.18em] uppercase text-xs mb-3"
          >
            Poznajmy się
          </p>
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight mb-8"
          >
            O mnie
          </h2>
          <br />
          <div
            class="space-y-6 text-gray-600 leading-relaxed text-left md:text-justify"
          >
            <p>
              Z wykształcenia i doświadczenia jestem prawniczką. Przez lata
              współpracowałam z kancelariami, gdzie rozwijałam skrupulatność,
              odpowiedzialność oraz umiejętność spojrzenia na sprawy z różnych
              perspektyw. Z czasem poczułam potrzebę pracy bliżej ludzi — w
              dynamicznym środowisku, gdzie moje działania mają realny wpływ na
              ważne decyzje życiowe.
            </p>
            <br />
            <p>
              Moja przygoda z nieruchomościami rozpoczęła się ponad 10 lat temu,
              kiedy szukałam swojego pierwszego mieszkania. Emocje, pytania i
              wątpliwości, które temu towarzyszyły, zainspirowały mnie do
              zgłębiania tego obszaru i stopniowo przekształciły pasję w
              profesjonalną ścieżkę zawodową.
            </p>
            <br />
            <p>
              Obecnie, jako agentka nieruchomości, łączę uważność na potrzeby
              klientów, dbałość o każdy detal oraz prawnicze doświadczenie,
              które daje moim klientom poczucie bezpieczeństwa. Wierzę, że
              nieruchomości to coś więcej niż mury — to przestrzeń do życia,
              rozwoju i spełniania marzeń. Moją misją jest pomagać klientom w
              znalezieniu miejsca, które naprawdę mogą nazwać swoim domem.
            </p>
          </div>
        </div>

        <!-- ZDJĘCIE -->
        <div class="relative w-full order-2">
          <div class="relative w-full max-w-lg mx-auto lg:max-w-none">
            <!-- Zdjęcie -->
            <img
              src="/images/agent_o_mnie.png"
              alt="Joanna Kardas-Śmiechowicz - O mnie"
              class="w-full h-auto rounded-[2rem] object-cover shadow-[0_20px_50px_-12px_rgba(0,0,0,0.15)] border border-gray-100"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA BLOGA ────────────────────────────────────────── -->
  <section id="blog" class="blog-section py-32 md:py-48 bg-base-200">
    <div class="container-layout">
      <div
        class="w-full flex flex-col items-center justify-center mb-24 md:mb-32"
        style="margin-bottom: 5rem;"
      >
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
          Najnowsze posty na Blogu
        </h2>
        <br />
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto">
          Zrozum rynek nieruchomości i zabezpiecz swoje interesy z eksperckimi
          poradami.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-7xl mx-auto"
      >
        {
          latestPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="blog-card">
              <div class="blog-card__image-wrap">
                <img
                  src={post.data.coverImage}
                  alt={post.data.alt}
                  class="blog-card__image"
                />
              </div>

              <div class="blog-card__body">
                <h3 class="blog-card__title">{post.data.title}</h3>
                <p class="blog-card__desc">{post.data.description}</p>

                <div class="blog-card__cta">
                  Czytaj dalej
                  <span class="blog-card__arrow">&rarr;</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO WRAPPER ─────────────────────────────────────────────── */
  .hero-section {
    min-height: 100svh; /* pełna wysokość viewportu               */
    display: flex;
    align-items: stretch;
    background-color: #ffffff;
  }

  /* ── GRID ─────────────────────────────────────────────────────── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* desktop: 50/50                */
    width: 100%;
  }

  /* ── LEWA KOLUMNA — placeholder zdjęcia ──────────────────────── */
  .photo-col {
    display: flex;
    align-items: stretch;
    padding-top: 2rem; /* Odstęp z góry na desktopie, by navbar nie zasłaniał głowy */
  }

  .photo-icon {
    width: 5rem;
    height: 5rem;
    opacity: 0.45;
  }

  .photo-hint {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* ── PRAWA KOLUMNA — treść ────────────────────────────────────── */
  .content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    padding-right: 6rem;
    /* padding-left jest obsługiwany przez klasy Tailwind (md:pl-20) */
    gap: 1.75rem;
  }

  /* Kicker — etykieta marki w magenta */
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ef0081; /* brand magenta                         */
    margin: 0;
  }

  /* Główny nagłówek */
  .headline {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1f2025;
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    gap: 0.25rem;
  }

  .headline-sub {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 400;
    color: #4b5563;
    letter-spacing: 0em;
  }

  /* Lead — krótki opis */
  .lead {
    font-size: 1rem;
    line-height: 1.75;
    color: #6b7280;
    margin: 0;
  }

  /* CTA row */
  .cta-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary-custom {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background-color: #ef0081;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 0.375rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      background-color 0.18s ease,
      transform 0.18s ease;
  }

  .btn-primary-custom:hover {
    background-color: #d40072;
    transform: translateY(-1px);
  }

  .btn-ghost-custom {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #4b5563;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.18s ease;
  }

  .btn-ghost-custom:hover {
    color: #ef0081;
  }

  .offer-section,
  .o-mnie-section,
  .blog-section {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    /* padding-inline zarządza .container-layout — nie nadpisuj tutaj */
  }

  /* ── RESPONSIVE — mobile ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero-section {
      height: 100svh;
      min-height: 100svh;
      max-height: 100svh;
      overflow: hidden;
    }

    .hero-grid {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      width: 100%;
    }

    .photo-col {
      order: 2;
      flex: 1 1 0;
      width: 100%;
      padding-top: 0;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      overflow: hidden;
    }

    .content-col {
      order: 1;
      flex: 0 0 auto;
      justify-content: start;
      padding-top: 2rem;
      padding-bottom: 0;
      gap: 1rem;
    }

    .headline {
      font-size: clamp(1.1rem, 6.6vw, 2rem);
      font-weight: 700;
      line-height: 1.1;
      color: #1f2025;
      letter-spacing: -0.04em;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .lead {
      max-width: none;
      line-height: 1.4;
    }

    .lead-desktop {
      display: none;
    }

    .cta-row {
      display: None;
    }

    /* padding-inline sekcji → .container-layout w global.css */
  }

  @media (max-width: 480px) {
    .content-col {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .cta-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .btn-primary-custom {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.querySelector(".carousel") as HTMLElement;
    if (!carousel) return;
    const items = Array.from(
      carousel.querySelectorAll(".carousel-item"),
    ) as HTMLElement[];
    if (items.length === 0) return;

    let autoScrollTimer: ReturnType<typeof setInterval> | undefined;

    const scrollNext = () => {
      if (
        carousel.scrollLeft + carousel.clientWidth >=
        carousel.scrollWidth - 10
      ) {
        carousel.scrollTo({ left: 0, behavior: "smooth" });
        return;
      }

      const carouselCenter = carousel.scrollLeft + carousel.clientWidth / 2;
      let closestIndex = 0;
      let minDistance = Infinity;

      items.forEach((item, index) => {
        const itemCenter = item.offsetLeft + item.clientWidth / 2;
        const distance = Math.abs(itemCenter - carouselCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = index;
        }
      });

      const nextIndex = (closestIndex + 1) % items.length;
      const nextItem = items[nextIndex];
      const targetLeft =
        nextItem.offsetLeft -
        carousel.clientWidth / 2 +
        nextItem.clientWidth / 2;

      carousel.scrollTo({ left: targetLeft, behavior: "smooth" });
    };

    const scrollPrev = () => {
      if (carousel.scrollLeft <= 10) {
        // Jesteśmy na początku, przeskakujemy na koniec
        carousel.scrollTo({ left: carousel.scrollWidth, behavior: "smooth" });
        return;
      }

      const carouselCenter = carousel.scrollLeft + carousel.clientWidth / 2;
      let closestIndex = 0;
      let minDistance = Infinity;

      items.forEach((item, index) => {
        const itemCenter = item.offsetLeft + item.clientWidth / 2;
        const distance = Math.abs(itemCenter - carouselCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = index;
        }
      });

      const prevIndex = (closestIndex - 1 + items.length) % items.length;
      const prevItem = items[prevIndex];
      const targetLeft =
        prevItem.offsetLeft -
        carousel.clientWidth / 2 +
        prevItem.clientWidth / 2;

      carousel.scrollTo({ left: targetLeft, behavior: "smooth" });
    };

    const startAutoScroll = () => {
      clearInterval(autoScrollTimer);
      autoScrollTimer = setInterval(scrollNext, 4000); // 4 sekundy
    };

    const stopAutoScroll = () => {
      clearInterval(autoScrollTimer);
    };

    // Obsługa dotyku i myszki - zatrzymywanie autoscrolla na hover
    carousel.addEventListener("mouseenter", stopAutoScroll);
    carousel.addEventListener("mouseleave", startAutoScroll);
    carousel.addEventListener("touchstart", stopAutoScroll, { passive: true });
    carousel.addEventListener("touchend", startAutoScroll, { passive: true });

    // Przyciski
    const prevBtn = document.querySelector(".prev-btn");
    const nextBtn = document.querySelector(".next-btn");

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        stopAutoScroll();
        scrollPrev();
      });
      prevBtn.addEventListener("mouseenter", stopAutoScroll);
      prevBtn.addEventListener("mouseleave", startAutoScroll);
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        stopAutoScroll();
        scrollNext();
      });
      nextBtn.addEventListener("mouseenter", stopAutoScroll);
      nextBtn.addEventListener("mouseleave", startAutoScroll);
    }

    // Inicjalizacja
    startAutoScroll();
  });
</script>

        >
          <div
            class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-gray-500 via-transparent to-transparent group-hover:opacity-20 transition-opacity"
          >
          </div>
          <svg
            class="absolute -top-8 -right-4 w-48 h-48 text-gray-300 opacity-20 transform rotate-45 group-hover:scale-110 transition-transform duration-700"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >

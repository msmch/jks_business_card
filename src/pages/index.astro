---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { oferty } from "../data/ofers.ts";
import { FACEBOOK_URL } from "../data/socials.ts";

// Pobieramy wszystkie wpisy z kolekcji 'blog' i sortujemy od najnowszego
const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Joanna Kardas-Śmiechowicz — Prawnik i Agent Nieruchomości"
  description="Pośrednictwo w obrocie nieruchomościami. Bezpieczne transakcje dzięki profesjonalnej obsłudze prawnej. Zaufaj doświadczeniu."
>
  <!-- ══════════════════════════════════════════════════════════
       HERO SECTION
       Desktop: 2 kolumny (zdjęcie | tekst), min-h-screen
       Mobile:  jedna kolumna — tekst najpierw, zdjęcie pod spodem
  ══════════════════════════════════════════════════════════ -->
  <section class="hero-section">
    <div class="hero-grid">
      <!-- ── LEWA KOLUMNA — placeholder na zdjęcie agenta ─────── -->
      <div class="photo-col mt-auto">
        <img
          src="/images/agent_zdjecie.webp"
          alt="Zdjęcie agenta"
          class="w-full h-full object-cover object-bottom aspect-[3/4] md:aspect-auto overflow-hidden"
        />
      </div>

      <!-- ── PRAWA KOLUMNA — treść ──────────────────────────────── -->
      <div class="content-col px-6 md:pl-20 lg:pl-24">
        <!-- Kicker / tag marki -->
        <p class="kicker">PRAWO &amp; NIERUCHOMOŚCI</p>

        <!-- Główny nagłówek -->
        <h1 class="headline">
          Joanna Kardas-Śmiechowicz
          <span class="headline-sub inline-block">
            <span id="typewriter"></span><span class="cursor">|</span>
          </span>
        </h1>

        <!-- Krótki opis -->
        <p class="lead lead-desktop">
          Pośrednictwo w obrocie nieruchomościami.
        </p>
        <p class="lead">
          Bezpieczeństwo umów, due diligence, negocjacje — wszystko w jednym
          miejscu.
        </p>

        <!-- CTA -->
        <div class="cta-row">
          <a href="#kontakt" class="btn-primary-custom">Umów konsultację</a>
          <a href="#oferta" class="btn-ghost-custom">Zobacz ofertę →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA OFERT ────────────────────────────────────────── -->
  <section id="oferta" class="offer-section bg-base-200">
    <div class="container-layout">
      <div class="w-full flex flex-col items-center justify-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
          Oferta
        </h2>
        <br />
        <p class="text-center text-gray-500 mt-4 max-w-4xl mx-auto">
          Zapraszam do zapoznania się z aktualnymi ofertami nieruchomości.
          Kliknij w ofertę aby dowiedzieć się więcej.
        </p>
      </div>

      <div class="relative w-full group/carousel px-4">
        <button
          class="prev-btn absolute left-0 md:left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full shadow-lg border border-gray-100 hidden md:flex items-center justify-center text-primary hover:bg-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer opacity-0 group-hover/carousel:opacity-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5L8.25 12l7.5-7.5"></path>
          </svg>
        </button>

        <div class="swiper my-swiper w-full py-12">
          <div class="swiper-wrapper">
            {
              [...oferty, ...oferty].map((oferta) => (
                <div class="swiper-slide !w-auto">
                  <a
                    href={oferta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card w-[20rem] md:w-[26rem] lg:w-[30rem] bg-base-100 shadow-sm hover:shadow-lg transition-shadow duration-300 border border-base-200 rounded-2xl overflow-hidden group block"
                  >
                    <figure class="relative overflow-hidden">
                      <img
                        src={oferta.image}
                        alt={oferta.alt}
                        class="w-full h-64 md:h-80 object-cover group-hover:scale-105 transition-transform duration-700"
                      />
                    </figure>
                    <div class="card-body !p-5">
                      <h3 class="card-title text-xl md:text-2xl font-bold text-gray-900 mb-3 leading-tight">
                        {oferta.title}
                      </h3>
                      <div class="flex items-center text-gray-500 text-sm md:text-base mb-6">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 mr-2 text-gray-400 shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        <span class="truncate">{oferta.location}</span>
                      </div>
                      <div class="mt-auto flex justify-between items-end">
                        <div class="text-primary font-bold text-xl md:text-2xl tracking-tight">
                          {oferta.price}
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
          <div class="swiper-pagination mt-8 relative"></div>
        </div>

        <button
          class="next-btn absolute right-0 md:right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full shadow-lg border border-gray-100 hidden md:flex items-center justify-center text-primary hover:bg-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer opacity-0 group-hover/carousel:opacity-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
          </svg>
        </button>
      </div>
      <div class="w-full flex flex-col items-center justify-center mt-12">
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
          Zachęcam do kontaktu!
        </h3>
        <p class="text-center text-gray-500 mt-4 max-w-4xl mx-auto">
          Masz na oku inne interesujące ogłoszenie? A może chcesz sprzedać swoją
          nieruchomość?
        </p>
        <p class="text-center text-gray-500 mt-4 max-w-4xl mx-auto">
          Odezwij się, na przykład przez mój profil na <a
            href={FACEBOOK_URL}
            class="text-primary hover:text-primary/80 underline font-medium transition-colors"
            >Facebooku</a
          > — pomogę Ci w analizie oferty i przejściu przez całą transakcję bezpiecznie
          i świadomie.
        </p>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA O MNIE ────────────────────────────────────────── -->
  <section id="o-mnie" class="o-mnie-section bg-white overflow-hidden">
    <div class="container-layout">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <div class="flex flex-col justify-center order-1" data-aos="fade-up">
          <p
            class="text-primary font-bold tracking-[0.18em] uppercase text-xs mb-3"
          >
            Poznajmy się
          </p>
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight mb-8"
          >
            O mnie
          </h2>
          <br />
          <div
            class="space-y-6 text-gray-600 leading-relaxed text-left md:text-justify"
          >
            <p>
              Z wykształcenia i doświadczenia jestem prawniczką. Przez lata
              współpracowałam z kancelariami, gdzie rozwijałam skrupulatność,
              odpowiedzialność oraz umiejętność spojrzenia na sprawy z różnych
              perspektyw. Z czasem poczułam potrzebę pracy bliżej ludzi — w
              dynamicznym środowisku, gdzie moje działania mają realny wpływ na
              ważne decyzje życiowe.
            </p>
            <br />
            <p>
              Moja przygoda z nieruchomościami rozpoczęła się ponad 10 lat temu,
              kiedy szukałam swojego pierwszego mieszkania. Emocje, pytania i
              wątpliwości, które temu towarzyszyły, zainspirowały mnie do
              zgłębiania tego obszaru i stopniowo przekształciły pasję w
              profesjonalną ścieżkę zawodową.
            </p>
            <br />
            <p>
              Obecnie, jako agentka nieruchomości, łączę uważność na potrzeby
              klientów, dbałość o każdy detal oraz prawnicze doświadczenie,
              które daje moim klientom poczucie bezpieczeństwa. Wierzę, że
              nieruchomości to coś więcej niż mury — to przestrzeń do życia,
              rozwoju i spełniania marzeń. Moją misją jest pomagać klientom w
              znalezieniu miejsca, które naprawdę mogą nazwać swoim domem.
            </p>
          </div>
        </div>

        <div
          class="relative w-full order-2"
          data-aos="fade-left"
          data-aos-delay="200"
        >
          <div class="relative w-full max-w-lg mx-auto lg:max-w-none">
            <img
              src="/images/agent_o_mnie.webp"
              alt="Joanna Kardas-Śmiechowicz - O mnie"
              class="w-full h-auto rounded-[2rem] object-cover shadow-[0_20px_50px_-12px_rgba(0,0,0,0.15)] border border-gray-100"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SEKCJA BLOGA ────────────────────────────────────────── -->
  <section id="blog" class="blog-section bg-base-200">
    <div class="container-layout">
      <div
        class="w-full flex flex-col items-center justify-center mb-24 md:mb-32"
        style="margin-bottom: 5rem;"
      >
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
          Najnowsze posty na Blogu
        </h2>
        <br />
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto">
          Zrozum rynek nieruchomości i zabezpiecz swoje interesy z eksperckimi
          poradami.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-7xl mx-auto"
      >
        {
          latestPosts.map((post, index) => (
            <a
              href={`/blog/${post.id}`}
              class="blog-card"
              data-aos="fade-up"
              data-aos-delay={index * 150}
            >
              <div class="blog-card__image-wrap">
                <img
                  src={post.data.coverImage}
                  alt={post.data.alt}
                  class="blog-card__image"
                  transition:name={`img-${post.id}`}
                />
              </div>

              <div class="blog-card__body">
                <h3
                  class="blog-card__title"
                  transition:name={`title-${post.id}`}
                >
                  {post.data.title}
                </h3>
                <p class="blog-card__desc">{post.data.description}</p>

                <div class="blog-card__cta">
                  Czytaj dalej
                  <span class="blog-card__arrow">&rarr;</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    background-color: var(--color-base-100);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
  }

  .photo-col {
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    background-color: var(--color-base-100);
  }

  .content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    gap: 1.75rem;
  }

  .headline {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-base-content);
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    gap: 0.25rem;
  }

  .headline-sub {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 400;
    color: var(--color-neutral);
    letter-spacing: 0em;
  }

  .cursor {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 300;
    margin-left: 2px;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    from,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .lead {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-neutral);
    margin: 0;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .content-col {
      padding-right: 6rem;
    }
  }

  @media (max-width: 768px) {
    .hero-grid {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      width: 100%;
    }

    .photo-col {
      order: 2;
      flex: 1 1 0;
      width: 100%;
      padding-top: 0;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      overflow: hidden;
    }

    .content-col {
      order: 1;
      flex: 0 0 auto;
      justify-content: flex-start;
      padding-top: 0.5rem;
      padding-bottom: 0;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      gap: 0.75rem;
    }

    .headline {
      font-size: clamp(1.1rem, 6.6vw, 2rem);
      font-weight: 700;
      line-height: 1.1;
      color: var(--color-base-content);
      letter-spacing: -0.04em;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .lead {
      max-width: none;
      line-height: 1.4;
    }

    .lead-desktop {
      display: none;
    }

    .cta-row {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .content-col {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .cta-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import {
    Navigation,
    Pagination,
    Autoplay,
    EffectCoverflow,
  } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";
  import "swiper/css/effect-coverflow";

  document.addEventListener("astro:page-load", () => {
    const swiperEl = document.querySelector(".my-swiper");
    if (!swiperEl) return;

    new Swiper(".my-swiper", {
      modules: [Navigation, Pagination, Autoplay, EffectCoverflow],
      effect: "coverflow",
      grabCursor: true,
      centeredSlides: true,
      slidesPerView: "auto",
      loop: true,
      initialSlide: 1,
      coverflowEffect: {
        rotate: 0,
        stretch: 0,
        depth: 100,
        modifier: 2.5,
        slideShadows: false,
      },
      autoplay: {
        delay: 3500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      navigation: {
        nextEl: ".next-btn",
        prevEl: ".prev-btn",
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
        dynamicBullets: true,
      },
    });
  });
</script>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const typewriterElement = document.getElementById("typewriter");
    if (!typewriterElement) return;

    const words = ["Agent nieruchomości", "Prawnik", "Twój doradca"];

    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function typeEffect() {
      const currentWord = words[wordIndex];

      if (isDeleting) {
        typewriterElement.textContent = currentWord.substring(0, charIndex - 1);
        charIndex--;
      } else {
        typewriterElement.textContent = currentWord.substring(0, charIndex + 1);
        charIndex++;
      }

      let typeSpeed = isDeleting ? 15 : 100;

      if (!isDeleting && charIndex === currentWord.length) {
        typeSpeed = 2000;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        typeSpeed = 500;
      }

      setTimeout(typeEffect, typeSpeed);
    }
    setTimeout(typeEffect, 1000);
  });
</script>

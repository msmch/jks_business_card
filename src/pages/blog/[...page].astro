---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
    const allPosts = await getCollection("blog");

    const sortedPosts = allPosts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );

    return paginate(sortedPosts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
    title="Blog o nieruchomościach i prawie | Joanna Kardas-Śmiechowicz"
    description="Eksperckie porady prawne, analizy rynku nieruchomości i wskazówki dla kupujących i sprzedających."
>
    <section class="py-32 md:py-48 bg-base-200">
        <div class="container mx-auto px-6 md:px-12 max-w-[1440px]">
            <div
                class="w-full flex flex-col items-center justify-center mb-16 md:mb-24"
            >
                <h1
                    class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight text-center"
                >
                    Blog Ekspercki
                </h1>
                <p
                    class="text-gray-500 mt-6 max-w-2xl mx-auto text-center text-lg"
                >
                    Zrozum rynek nieruchomości i zabezpiecz swoje interesy z
                    eksperckimi poradami.
                </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10"
            >
                {
                    page.data.map((post) => (
                        /* Wykorzystujemy dokładnie ten sam styl karty co na stronie głównej! */
                        <a
                            href={`/blog/${post.id}`}
                            class="card w-full bg-white shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 rounded-2xl overflow-hidden group flex flex-col"
                        >
                            <div class="relative h-48 md:h-56 bg-[#F3F4F7] overflow-hidden flex items-center justify-center">
                                <img
                                    src={post.data.coverImage}
                                    alt={post.data.alt}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                />
                            </div>

                            <div class="card-body p-6 md:p-8 flex flex-col h-full">
                                <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-[#EF0081] transition-colors line-clamp-2">
                                    {post.data.title}
                                </h3>
                                <p class="text-gray-600 mb-6 line-clamp-3">
                                    {post.data.description}
                                </p>

                                <div class="mt-auto text-[#EF0081] text-sm font-bold uppercase tracking-wider flex items-center">
                                    Czytaj dalej
                                    <span class="ml-2 group-hover:translate-x-1 transition-transform">
                                        &rarr;
                                    </span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>

            {
                page.lastPage > 1 && (
                    <div class="mt-20 flex justify-between items-center border-t border-gray-200 pt-8">
                        <div class="w-32">
                            {page.url.prev ? (
                                <a
                                    href={page.url.prev}
                                    class="btn-ghost-custom flex items-center gap-2"
                                >
                                    &larr; Nowsze
                                </a>
                            ) : null}
                        </div>

                        <span class="text-gray-500 font-medium">
                            Strona {page.currentPage} z {page.lastPage}
                        </span>

                        <div class="w-32 text-right">
                            {page.url.next ? (
                                <a
                                    href={page.url.next}
                                    class="btn-ghost-custom flex items-center justify-end gap-2"
                                >
                                    Starsze &rarr;
                                </a>
                            ) : null}
                        </div>
                    </div>
                )
            }
        </div>
    </section>
</BaseLayout>

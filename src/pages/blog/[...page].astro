---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
    const allPosts = await getCollection("blog");

    const sortedPosts = allPosts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );

    return paginate(sortedPosts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BlogLayout
    title="Blog o nieruchomościach i prawie | Joanna Kardas-Śmiechowicz"
    description="Eksperckie porady prawne, analizy rynku nieruchomości i wskazówki dla kupujących i sprzedających."
>
    <!-- ── Sekcja intro ───────────────────────────────────────── -->
    <section class="blog-intro">
        <div class="container-layout blog-intro__inner">
            <!-- Zdjęcie agentki -->
            <div class="blog-intro__image-wrap">
                <div class="relative w-full max-w-lg mx-auto lg:max-w-none">
                    <img
                        src="/images/agent_blog.webp"
                        alt="Joanna Kardas-Śmiechowicz — autorka bloga"
                        class="w-full h-auto rounded-[2rem] object-cover shadow-[0_20px_50px_-12px_rgba(0,0,0,0.15)] border border-gray-100"
                    />
                </div>
            </div>

            <!-- Tekst wprowadzenia -->
            <div class="blog-intro__content">
                <h1 class="blog-intro__heading">Blog</h1>
                <p class="blog-intro__lead">
                    Witaj na moim blogu! Znajdziesz tu eksperckie porady prawne,
                    rzetelne analizy rynku nieruchomości oraz praktyczne
                    wskazówki dla kupujących i sprzedających. Piszę przystępnie,
                    bo wiem, że rynek nieruchomości bywa skomplikowany — a dobra
                    wiedza to najlepsza inwestycja.
                </p>
                <p class="blog-intro__sub">
                    Joanna Kardas-Śmiechowicz &mdash; prawnik, doradca
                    ds.&nbsp;nieruchomości
                </p>
            </div>
        </div>
    </section>

    <!-- ── Siatka wpisów ─────────────────────────────────────── -->
    <section class="blog-grid-section">
        <div class="container-layout">
            <div class="blog-grid">
                {
                    page.data.map((post) => (
                        <a href={`/blog/${post.id}`} class="blog-card">
                            <div class="blog-card__image-wrap">
                                <img
                                    src={post.data.coverImage}
                                    alt={post.data.alt}
                                    class="blog-card__image"
                                    transition:name={`img-${post.id}`}
                                />
                            </div>

                            <div class="blog-card__body">
                                <h3
                                    class="blog-card__title"
                                    transition:name={`title-${post.id}`}
                                >
                                    {post.data.title}
                                </h3>
                                <p class="blog-card__desc">
                                    {post.data.description}
                                </p>

                                <div class="blog-card__cta">
                                    Czytaj dalej
                                    <span class="blog-card__arrow">&rarr;</span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>

            <!-- Paginacja -->
            {
                page.lastPage > 1 && (
                    <div class="blog-pagination">
                        <div class="blog-pagination__prev">
                            {page.url.prev ? (
                                <a
                                    href={page.url.prev}
                                    class="btn-ghost-custom"
                                >
                                    &larr; Nowsze
                                </a>
                            ) : null}
                        </div>

                        <span class="blog-pagination__info">
                            Strona {page.currentPage} z {page.lastPage}
                        </span>

                        <div class="blog-pagination__next">
                            {page.url.next ? (
                                <a
                                    href={page.url.next}
                                    class="btn-ghost-custom"
                                >
                                    Starsze &rarr;
                                </a>
                            ) : null}
                        </div>
                    </div>
                )
            }
        </div>
    </section>
</BlogLayout>

<style>
    /* ── Intro section ────────────────────────────────────────── */

    .blog-intro {
        background: linear-gradient(135deg, #f5f6f8 0%, #ffffff 100%);
        padding-block: 2rem 3rem;
        border-bottom: 1px solid #e8eaed;
    }

    .blog-intro__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2.5rem;
    }

    @media (min-width: 768px) {
        .blog-intro__inner {
            flex-direction: row;
            align-items: center;
            gap: 4rem;
        }
    }

    .blog-intro__image-wrap {
        flex-shrink: 0;
        width: 100%;
    }

    @media (min-width: 768px) {
        .blog-intro__image-wrap {
            width: 48%;
        }
    }

    .blog-intro__content {
        flex: 1;
        text-align: center;
    }

    @media (min-width: 768px) {
        .blog-intro__content {
            text-align: left;
        }
    }

    .blog-intro__heading {
        font-size: clamp(2.5rem, 5vw, 3.75rem);
        font-weight: 800;
        color: #1f2025;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
    }

    .blog-intro__lead {
        font-size: 1.0625rem;
        color: #4b5563;
        line-height: 1.75;
        margin-bottom: 1.25rem;
        max-width: 56ch;
    }

    .blog-intro__sub {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-primary)
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    /* ── Blog grid section ────────────────────────────────────── */

    .blog-grid-section {
        padding-block: 4rem 5rem;
        background-color: #ffffff;
    }

    @media (min-width: 768px) {
        .blog-grid-section {
            padding-block: 5rem 6rem;
        }
    }

    .blog-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 640px) {
        .blog-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
        }
    }

    @media (min-width: 1024px) {
        .blog-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
        }
    }

    /* ── Pagination ───────────────────────────────────────────── */

    .blog-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #e8eaed;
    }

    .blog-pagination__prev {
        width: 8rem;
    }

    .blog-pagination__next {
        width: 8rem;
        text-align: right;
    }

    .blog-pagination__info {
        color: #6b7280;
        font-weight: 500;
        font-size: 0.9375rem;
    }
</style>

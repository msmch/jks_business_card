---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");
    return blogEntries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BlogLayout title={entry.data.title} description={entry.data.description}>
    <article class="blog-post">
        <div class="container-layout blog-post__inner">
            <header class="blog-post__header">
                <p class="blog-post__meta">
                    {entry.data.pubDate.toISOString().split("T")[0]} &bull; {
                        entry.data.author
                    }
                </p>
                <h1 class="blog-post__title">
                    {entry.data.title}
                </h1>

                <img
                    src={entry.data.coverImage}
                    alt={entry.data.alt}
                    class="blog-post__cover"
                />
            </header>

            <div
                class="prose prose-lg prose-gray max-w-none prose-headings:text-gray-900 prose-a:text-[#EF0081] hover:prose-a:text-[#d40072]"
            >
                <Content />
            </div>

            <div class="blog-post__back">
                <a href="/blog" class="btn-ghost-custom">
                    &larr; Wróć do listy wpisów
                </a>
            </div>
        </div>
    </article>
</BlogLayout>

<style>
    .blog-post {
        padding-block: 3.5rem 5rem;
        background: #ffffff;
    }

    @media (min-width: 768px) {
        .blog-post {
            padding-block: 4.5rem 6rem;
        }
    }

    .blog-post__inner {
        max-width: 56rem; /* widened for better reading experience */
    }

    .blog-post__header {
        margin-bottom: 3rem;
        text-align: center;
    }

    .blog-post__meta {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #ef0081;
        margin-bottom: 1rem;
    }

    .blog-post__title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        color: #1f2025;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    .blog-post__cover {
        width: 100%;
        height: 24rem;
        object-fit: cover;
        border-radius: 1.5rem;
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.08),
            0 1px 4px rgba(0, 0, 0, 0.04);
        border: 1px solid #e8eaed;
    }

    .blog-post__back {
        margin-top: 2rem;
        padding-top: 2rem;
    }

    /* btn-ghost-custom — scoped forward reference */
    :global(.btn-ghost-custom) {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: #4b5563;
        text-decoration: none;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        transition:
            color 0.2s ease,
            background-color 0.2s ease;
    }

    :global(.btn-ghost-custom:hover) {
        color: #ef0081;
        background-color: #fdf2f8;
    }

    /* ── Typography fixes ────────────────────────────────────── */
    :global(.prose) {
        line-height: 1.85 !important;
    }

    :global(.prose p) {
        margin-bottom: 1.75em !important;
    }

    :global(.prose ul),
    :global(.prose ol) {
        padding-left: 2.5rem !important;
        margin-block: 1.5em !important;
    }

    :global(.prose li) {
        margin-bottom: 0.75em !important;
    }
</style>

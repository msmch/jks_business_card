---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Canonical URL dla tej strony (opcjonalny) */
  canonical?: string;
  /** URL obrazu OG (opcjonalny) */
  ogImage?: string;
}

const {
  title,
  description = "Twoje wymarzone nieruchomości — profesjonalne doradztwo na rynku nieruchomości w Polsce.",
  canonical = Astro.url.href,
  ogImage = "/og-default.png",
} = Astro.props;

const siteName = "RealEstate";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="pl" data-theme="corporate">
  <head>
    <!-- ── Encoding & Viewport ────────────────────────────────── -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ── Fonts ────────────────────────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- ── Primary SEO ───────────────────────────────────────── -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- ── Open Graph (Facebook / Messenger preview) ─────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pl_PL" />

    <!-- ── Twitter / X Card ──────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ── Favicon ───────────────────────────────────────────── -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Joanna" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- ── Robots ────────────────────────────────────────────── -->
    <meta name="robots" content="index, follow" />
  </head>

  <body>
    <!-- ── Header ────────────────────────────────────────────── -->
    <header id="main-header" class="absolute left-0 w-full top-0 z-50">
      <div class="container-layout flex justify-end items-center h-16 md:h-20">
        <button
          id="mobile-menu-btn"
          type="button"
          class="relative w-10 h-10 flex items-center justify-center md:hidden text-gray-500 hover:text-gray-900 focus:outline-none"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Otwórz menu</span>

          <svg
            id="icon-menu"
            class="absolute inset-0 m-auto h-10 w-10 transition-all duration-500 transform opacity-100 rotate-0"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>

          <svg
            id="icon-close"
            class="absolute inset-0 m-auto h-10 w-10 transition-all duration-500 transform opacity-0 -rotate-90"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <nav class="hidden md:flex md:items-center gap-12 lg:gap-16">
          <a
            href="#o-mnie"
            class="text-gray-700 hover:text-gray-900 py-2 text-sm font-medium transition-colors"
            >O mnie</a
          >
          <a
            href="#oferta"
            class="text-gray-700 hover:text-gray-900 py-2 text-sm font-medium transition-colors"
            >Oferty</a
          >
          <a
            href="/blog"
            class="text-gray-700 hover:text-gray-900 py-2 text-sm font-medium transition-colors"
            >Blog</a
          >
        </nav>
      </div>
    </header>
    <!-- Mobile Menu overlay -->
    <div
      id="mobile-menu"
      class="fixed inset-0 bg-white z-40 -translate-y-full transition-transform duration-500 md:hidden pt-20"
    >
      <div
        class="px-2 pt-2 pb-3 space-y-1 sm:px-3 flex flex-col items-center justify-center h-full gap-8"
      >
        <a
          href="#o-mnie"
          class="block px-3 py-2 rounded-md text-2xl font-medium text-gray-900 hover:text-gray-700"
          >O mnie</a
        >
        <a
          href="#oferta"
          class="block px-3 py-2 rounded-md text-2xl font-medium text-gray-900 hover:text-gray-700"
          >Oferty</a
        >
        <a
          href="/blog"
          class="block px-3 py-2 rounded-md text-2xl font-medium text-gray-900 hover:text-gray-700"
          >Blog</a
        >
        <a
          href="#kontakt"
          class="block px-3 py-2 rounded-md text-2xl font-medium text-gray-900 hover:text-gray-700"
          >Kontakt</a
        >
      </div>
    </div>

    <!-- ── Main page content ─────────────────────────────────── -->
    <main class="pt-20 md:pt-28">
      <slot />
    </main>

    <!-- ── Footer ────────────────────────────────────────────── -->
    <Footer />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const header = document.getElementById("main-header");
        let isMenuOpen = false;

        const menuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const iconMenu = document.getElementById("icon-menu");
        const iconClose = document.getElementById("icon-close");

        const mobileLinks = mobileMenu.querySelectorAll("a");

        function openMobileMenu() {
          isMenuOpen = true;
          mobileMenu.classList.remove("-translate-y-full");
          mobileMenu.classList.add("translate-y-0");

          iconMenu.classList.remove("opacity-100", "rotate-0");
          iconMenu.classList.add("opacity-0", "rotate-90");

          iconClose.classList.remove("opacity-0", "-rotate-90");
          iconClose.classList.add("opacity-100", "rotate-0");
        }

        function closeMobileMenu() {
          isMenuOpen = false;
          mobileMenu.classList.remove("translate-y-0");
          mobileMenu.classList.add("-translate-y-full");

          iconMenu.classList.remove("opacity-0", "rotate-90");
          iconMenu.classList.add("opacity-100", "rotate-0");

          iconClose.classList.remove("opacity-100", "rotate-0");
          iconClose.classList.add("opacity-0", "-rotate-90");
        }

        menuBtn.addEventListener("click", (e) => {
          e.preventDefault();
          if (isMenuOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });

        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            if (isMenuOpen) {
              closeMobileMenu();
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /*
   * CSS Reset — czyste, białe tło, zero domyślnych marginesów.
   * Zakres globalny (is:global) — działa na każdy element w drzewie DOM.
   */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    background-color: #ffffff;
    color: #1f2025;
    min-height: 100vh;
    overflow-x: hidden;
    font-family:
      "Inter",
      "Segoe UI",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img,
  video {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
  }
</style>
